# Local development only. Replace database password and HMAC key for deployment.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://charitycheck:local-development-only@127.0.0.1:5433/charitycheck
AUDIT_HMAC_KEY=replace-with-random-at-least-32-characters
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
RETENTION_DAYS=30
# Default: no external provider is called.
BANK_PROVIDER=none
# After production access and use approval from Midtrans Iris:
# BANK_PROVIDER=midtrans-iris
# MIDTRANS_IRIS_API_KEY=
# Use the Iris production API key, not a Snap/Core merchant key.
